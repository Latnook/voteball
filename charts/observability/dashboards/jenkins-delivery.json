{
  "uid": "voteball-delivery",
  "title": "Jenkins & Delivery",
  "tags": ["voteball", "ci"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue length",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jenkins_queue_size_value{namespace=\"ci\"}",
          "legendFormat": "queue size",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jenkins_queue_buildable_value{namespace=\"ci\"}",
          "legendFormat": "buildable",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jenkins_queue_blocked_value{namespace=\"ci\"}",
          "legendFormat": "blocked",
          "refId": "C"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jenkins_queue_stuck_value{namespace=\"ci\"}",
          "legendFormat": "stuck",
          "refId": "D"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue wait time (last build)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "default_jenkins_builds_last_build_waiting_milliseconds{namespace=\"ci\"}",
          "legendFormat": "{{jenkins_job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Executors: total vs busy",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 18, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jenkins_executor_count_value{namespace=\"ci\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jenkins_executor_in_use_value{namespace=\"ci\"}",
          "legendFormat": "busy",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Online agents",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jenkins_node_online_value{namespace=\"ci\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Build outcomes (1h increase)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(jenkins_runs_success_total{namespace=\"ci\"}[1h])",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(jenkins_runs_failure_total{namespace=\"ci\"}[1h])",
          "legendFormat": "failure",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(jenkins_runs_unstable_total{namespace=\"ci\"}[1h])",
          "legendFormat": "unstable",
          "refId": "C"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(jenkins_runs_aborted_total{namespace=\"ci\"}[1h])",
          "legendFormat": "aborted",
          "refId": "D"
        }
      ]
    },
    {
      "id": 6,
      "title": "Build duration (last build)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "default_jenkins_builds_last_build_duration_milliseconds{namespace=\"ci\"}",
          "legendFormat": "{{jenkins_job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Controller JVM heap",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "bytes"},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "vm_memory_heap_used{namespace=\"ci\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "vm_memory_heap_max{namespace=\"ci\"}",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Last successful release (currently deployed)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 32, "w": 24, "h": 6},
      "description": "The end of the delivery chain, on the delivery dashboard: a release only becomes the running one by passing application-cd, so what is serving traffic right now IS the last successful release. Read from the application's own voteball_app_info rather than from a Jenkins build counter deliberately -- a green CD build says the pipeline finished, not that the cluster is running what it promoted, and those two have disagreed here before. `release` is the image digest when the chart pins one.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "service": true
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "voteball_app_info{namespace=\"devops-app\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Commits",
      "description": "Commit volume next to the builds it caused -- the reason these panels live on the delivery dashboard rather than a GitHub one of their own.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": {"type": "grafana-github-datasource", "uid": "github"},
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Commits",
          "owner": "Latnook",
          "repository": "voteball",
          "options": { "ref": "master" },
          "datasource": {"type": "grafana-github-datasource", "uid": "github"}
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Contributors",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 38 },
      "datasource": {"type": "grafana-github-datasource", "uid": "github"},
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Contributors",
          "owner": "Latnook",
          "repository": "voteball",
          "datasource": {"type": "grafana-github-datasource", "uid": "github"}
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Open issues",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 38 },
      "datasource": {"type": "grafana-github-datasource", "uid": "github"},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Issues",
          "owner": "Latnook",
          "repository": "voteball",
          "options": { "query": "is:open" },
          "datasource": {"type": "grafana-github-datasource", "uid": "github"}
        }
      ]
    }
  ]
}
