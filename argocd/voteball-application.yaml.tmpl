# The complete ArgoCD-side configuration for this deployment: an AppProject that bounds what may be
# deployed, and the Application that does the deploying. Both live here so there is exactly one file
# to read to know what ArgoCD is allowed to do -- and nothing to click.
#
# A TEMPLATE, not a manifest: ${REPO_URL} is filled in by scripts/render-argocd-app.sh from the
# `github_repo` Terraform output, so a fork supplies its own repository via voteball.tfvars like
# everything else. Rendered to stdout and piped straight into `kubectl apply -f -`, so no generated
# copy is left on disk to drift or be edited by mistake.
#
# Do NOT `kubectl apply` this file directly -- kubectl does not expand ${REPO_URL}, and ArgoCD would
# accept the resulting Application and then fail to fetch a repository that does not exist.
#
# Document ORDER is load-bearing: kubectl applies a multi-document stream top to bottom, so the
# AppProject exists before the Application that references it. Reversed, the Application lands first
# in a "project voteball does not exist" error state until the next reconcile.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: voteball
  namespace: argocd
spec:
  description: Voteball delivery. Deploys charts/voteball from this repo into devops-app, nothing else.

  # Exactly one repo and one destination. The stock `default` project -- which this Application used
  # until 2026-08-03 -- allows '*' for all three of these, so an Application created by mistake (or
  # by anyone who reaches the API) could deploy an arbitrary repo into kube-system. Naming the repo
  # and namespace here is the difference between "we only deploy one thing" being a description of
  # current state and being an enforced rule.
  sourceRepos:
    - ${REPO_URL}
  destinations:
    - server: https://kubernetes.default.svc
      namespace: devops-app

  # Empty = DENY every cluster-scoped resource. charts/voteball renders only namespaced kinds
  # (Deployment, Service, Ingress, ConfigMap, ExternalSecret, SecretStore, ServiceAccount, Job,
  # CronJob, HPA, PDB, NetworkPolicy, PrometheusRule) -- verify with:
  #     helm template voteball charts/voteball -n devops-app | grep '^kind:' | sort -u
  # If the chart ever gains a ClusterRole/ClusterRoleBinding/CRD, sync fails CLOSED with
  # "resource ... is not permitted in project voteball" rather than silently granting cluster scope.
  # That is the intended behaviour: whitelist it here deliberately, in this file, in a commit.
  clusterResourceWhitelist: []

  # Anything namespaced is fine -- `destinations` already pins it to devops-app, so this is not a
  # second lock, just an absence of one. Enumerating kinds here would break the chart every time it
  # gained a resource type, with no security gain the destination pin does not already provide.
  namespaceResourceWhitelist:
    - group: '*'
      kind: '*'
---
# ArgoCD watches the public repo's charts/voteball on the RELEASE branch and keeps devops-app in
# sync. ServerSideApply adopts the resources helm already created (no delete/redeploy, so the ALB is
# not re-provisioned). prune+selfHeal make git the source of truth going forward.
#
# `release`, NOT `master`, since 2026-08-23 -- see
# docs/design/2026-08-23-release-branch-and-digest-design.md. `master` is where humans and deploy.sh
# push; `release` is written ONLY by application-cd's Promote stage, via
# scripts/ci/promote-to-release.sh. Two findings from the Task 4 review shared one root cause -- that
# master was simultaneously the development and the deployment branch:
#
#   * CD had to push its promotion commit to the branch CI watches, so a source commit pushed while
#     CI was busy could hide behind it and never be built (the real 2026-08-21 incident).
#   * every gate in Jenkinsfile-ci is `changeset 'services/**'`, so a chart-only commit skipped CI
#     entirely and THIS Application's automated sync applied it straight to the cluster -- past
#     manifest validation, the smoke test, the monitoring gate and rollback.
#
# Pointing this at `release` closes both: there is now no way to reach devops-app by pushing to a
# branch. If you change this back to master you reopen both, and nothing will tell you.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: voteball
  namespace: argocd
spec:
  project: voteball
  source:
    repoURL: ${REPO_URL}
    targetRevision: release
    path: charts/voteball
  destination:
    server: https://kubernetes.default.svc
    namespace: devops-app
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - ServerSideApply=true   # adopt existing helm-created resources in place
      - CreateNamespace=false  # devops-app already exists
---
# The observability project. Separate from `voteball` because it deploys a different chart into a
# different namespace, and an AppProject's whole purpose is to pin exactly that pair. Reusing the
# voteball project would mean widening its destination to two namespaces, which would let a mistake in
# either chart deploy into the other's namespace.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: observability
  namespace: argocd
spec:
  description: Dashboards, platform alerts and network policy. Deploys charts/observability into observability, nothing else.
  sourceRepos:
    - ${REPO_URL}
  destinations:
    - server: https://kubernetes.default.svc
      namespace: observability
  # Empty = DENY every cluster-scoped resource, same as the voteball project. This chart renders only
  # ConfigMaps, PrometheusRules and NetworkPolicies -- all namespaced. Verify with:
  #     helm template observability charts/observability -n observability | grep '^kind:' | sort -u
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: '*'
      kind: '*'
---
# CreateNamespace=false: Terraform's kube-prometheus-stack release created `observability` with
# create_namespace, so it already exists. ServerSideApply for the same reason the voteball Application
# uses it -- these objects share a namespace with resources Helm created, and field ownership has to
# be shared rather than fought over.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: observability
  namespace: argocd
spec:
  project: observability
  source:
    repoURL: ${REPO_URL}
    targetRevision: release
    path: charts/observability
  destination:
    server: https://kubernetes.default.svc
    namespace: observability
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - ServerSideApply=true
      - CreateNamespace=false
